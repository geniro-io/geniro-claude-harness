@@ -0,0 +1,26 @@
+export interface TruncateOptions {
+  maxLength: number;
+  ellipsis?: string;
+}
+
+const graphemeSegmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" });
+
+function toGraphemes(value: string): string[] {
+  return Array.from(graphemeSegmenter.segment(value), (entry) => entry.segment);
+}
+
+export function truncate(input: string, options: TruncateOptions): string {
+  const ellipsis = options.ellipsis ?? "…";
+  if (options.maxLength <= 0) {
+    throw new RangeError(`maxLength must be positive, got ${options.maxLength}`);
+  }
+  const chars = toGraphemes(input);
+  if (chars.length <= options.maxLength) {
+    return input;
+  }
+  const ellipsisLength = toGraphemes(ellipsis).length;
+  if (options.maxLength <= ellipsisLength) {
+    return chars.slice(0, options.maxLength).join("");
+  }
+  return chars.slice(0, options.maxLength - ellipsisLength).join("") + ellipsis;
+}
diff --git a/test/truncate.test.ts b/test/truncate.test.ts
new file mode 100644
index 0000000..c62673d
--- /dev/null
+++ b/test/truncate.test.ts
@@ -0,0 +1,25 @@
+import { truncate } from "../src/truncate";
+
+describe("truncate", () => {
+  it("returns short strings unchanged", () => {
+    expect(truncate("abc", { maxLength: 5 })).toBe("abc");
+  });
+  it("truncates with default ellipsis", () => {
+    expect(truncate("abcdefgh", { maxLength: 5 })).toBe("abcd…");
+  });
+  it("returns exact-length strings unchanged", () => {
+    expect(truncate("abcde", { maxLength: 5 })).toBe("abcde");
+  });
+  it("handles maxLength shorter than the ellipsis", () => {
+    expect(truncate("abcdefgh", { maxLength: 1 })).toBe("a");
+  });
+  it("supports a custom ellipsis", () => {
+    expect(truncate("abcdefgh", { maxLength: 6, ellipsis: "..." })).toBe("abc...");
+  });
+  it("throws on non-positive maxLength", () => {
+    expect(() => truncate("abc", { maxLength: 0 })).toThrow(RangeError);
+  });
+  it("keeps a surrogate pair intact instead of splitting it", () => {
+    expect(truncate("\u{1F600}bc", { maxLength: 2 })).toBe("\u{1F600}…");
+  });
+});
