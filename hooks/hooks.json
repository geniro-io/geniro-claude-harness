{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-geniro-force-add.sh",
            "statusMessage": "Checking for git add -f on .geniro/..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/geniro-check-update.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-restore.sh",
            "statusMessage": "Restoring Geniro context...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
