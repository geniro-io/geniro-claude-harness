@@ -1,8 +1,18 @@
 import { Router } from "express";
 import { requireAdmin } from "../auth";
+import { notifySlack } from "../slack";
 
 export const adminRouter = Router();
 
 adminRouter.get("/admin/users", requireAdmin, async (_req, res) => {
   res.json({ users: [] });
 });
+
+adminRouter.post("/admin/users/:id/ban", async (req, res) => {
+  await notifySlack(`user ${req.params.id} banned`);
+  res.json({ banned: req.params.id });
+});
+
+adminRouter.get("/admin/login-return", (req, res) => {
+  res.redirect(String(req.query.next ?? "/"));
+});
