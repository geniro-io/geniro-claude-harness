    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D4 — Authoring-rules compliance",
      "to": "criteria/D4-rules.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D5 — Logic & syntax correctness",
      "to": "criteria/D5-logic.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D6 — Over-complication & instruction bloat",
      "to": "criteria/D6-simplicity.md"
