    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D8 — Safety & test coverage",
      "to": "criteria/D8-safety.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D9 — Wiring completeness (declared vs. wired)",
      "to": "criteria/D9-wiring.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "Severity tiers (shared output classification)",
      "to": "criteria/severity-tiers.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "Do-not-flag list (endorsed patterns)",
      "to": "criteria/do-not-flag.md"
    },
    {
      "from": "skills/_shared/audit-pipeline.md",
