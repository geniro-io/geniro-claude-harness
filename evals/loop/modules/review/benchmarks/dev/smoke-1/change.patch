diff --git a/src/orders/total.ts b/src/orders/total.ts
index 1efa444..3c11c6a 100644
--- a/src/orders/total.ts
+++ b/src/orders/total.ts
@@ -5,9 +5,17 @@ export interface OrderItem {
 }
 
 export function itemTotal(item: OrderItem): number {
-  return item.price * item.qty;
+  const discounted = item.price * (1 - item.discount.pct / 100);
+  return discounted * item.qty;
 }
 
 export function orderTotal(items: OrderItem[]): number {
   return items.reduce((sum, it) => sum + itemTotal(it), 0);
 }
+
+export async function fetchOrderItems(orderId: string): Promise<OrderItem[]> {
+  const { db } = await import("../db");
+  return db
+    .query("SELECT price, qty, discount FROM order_items WHERE order_id = $1", [orderId])
+    .catch(() => []) as Promise<OrderItem[]>;
+}
