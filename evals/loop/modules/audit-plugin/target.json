    },
    {
      "from": ".claude/rules/skill-structure.md",
      "to": "criteria/rule-skill-structure.md"
    }
  ],
  "screen_facets": [
    "staleness",
    "logic",
    "safety",
    "wiring"
  ],
  "noise_floor": 2.75,
  "noise_floor_note": "UPPER BOUND, not a clean measurement. EXP-012 measured 2.75/task over four dev tasks, one of which (plugin-neg-1) was a mis-specified negative control carrying four real defects — the correct answer on it was non-empty, so both arms' findings there were legitimate and scored as noise. A contaminated task inflates this band, which makes verdicts insensitive rather than wrong: nothing is promoted that should not be. Re-measure on the repaired fixture before reading a near-threshold result."
}
