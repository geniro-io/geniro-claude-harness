@@ -0,0 +1,18 @@
+export interface TruncateOptions {
+  maxLength: number;
+  ellipsis?: string;
+}
+
+export function truncate(input: string, options: TruncateOptions): string {
+  const ellipsis = options.ellipsis ?? "…";
+  if (options.maxLength <= 0) {
+    throw new RangeError(`maxLength must be positive, got ${options.maxLength}`);
+  }
+  if (input.length <= options.maxLength) {
+    return input;
+  }
+  if (options.maxLength <= ellipsis.length) {
+    return input.slice(0, options.maxLength);
+  }
+  return input.slice(0, options.maxLength - ellipsis.length) + ellipsis;
+}
diff --git a/test/truncate.test.ts b/test/truncate.test.ts
