  "output_contract": {
    "retry_regex": "\\| *\\[?T[0-5]\\]? *\\|",
    "clean_regex": "## Dimension verdict"
  },
  "pass_expr": ".recall_must == 1",
  "negative_pass_expr": "(.noise_strict // 0) == 0 and (.plausible_real // 0) == 0",
  "champion_sync": [
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D2 — Cross-file consistency",
      "to": "criteria/D2-consistency.md"
    },
    {
      "from": ".claude/skills/audit-plugin/dimensions-reference.md",
      "section": "D3 — Stale rules & dead references",
