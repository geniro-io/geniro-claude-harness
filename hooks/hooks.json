{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-dangerous-git.sh",
            "statusMessage": "Checking for destructive git operations..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-geniro-deletion.sh",
            "statusMessage": "Checking for unsafe .geniro/ deletions..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/file-protection.sh",
            "statusMessage": "Checking shell command for protected-file writes..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-state-helper.sh",
            "statusMessage": "Checking shell command for direct state-file writes..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-tdd-order.sh",
            "statusMessage": "Checking shell command for TDD-order constraint..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/security-pattern-check.sh",
            "statusMessage": "Scanning shell command for security anti-patterns..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/file-protection.sh",
            "statusMessage": "Protecting sensitive files..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-tdd-order.sh",
            "statusMessage": "Checking TDD-order constraint..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-state-helper.sh",
            "statusMessage": "Checking state-helper usage..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/security-pattern-check.sh",
            "statusMessage": "Scanning for security anti-patterns..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-gate-render.sh",
            "statusMessage": "Checking the question has its context message..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/geniro-check-update.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-restore.sh",
            "statusMessage": "Restoring Geniro context...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
